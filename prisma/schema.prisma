generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model addresses {
  id           String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id      String    @db.Uuid
  is_primary   Boolean   @default(false)
  label        String?   @db.VarChar(50)
  address      String?   @db.VarChar(255)
  address_info String?   @db.VarChar(255)
  city         String?   @db.VarChar(255)
  country      String?   @db.VarChar(255)
  zip          String?   @db.VarChar(20)
  created_at   DateTime? @default(now()) @db.Timestamp(6)
  updated_at   DateTime? @default(now()) @db.Timestamp(6)
  first_name   String?   @db.VarChar(255)
  last_name    String?   @db.VarChar(255)
  users        users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_address_user")
}

model materials {
  id            Int        @id @default(autoincrement())
  name          String     @db.VarChar(100)
  type          String     @db.VarChar(50)
  cost_per_gram Decimal    @db.Decimal(10, 4)
  density       Decimal    @db.Decimal(10, 4)
  color         String?    @db.VarChar(50)
  is_available  Boolean?   @default(true)
  created_at    DateTime?  @default(now()) @db.Timestamp(6)
  products      products[]
  quotes        quotes[]
}

model order_items {
  id          Int       @id @default(autoincrement())
  order_id    String?   @db.Uuid
  product_id  Int?
  quantity    Int       @default(1)
  unit_price  Decimal   @db.Decimal(10, 2)
  total_price Decimal   @db.Decimal(10, 2)
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  orders      orders?   @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products    products? @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model orders {
  id                   String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id              String?       @db.Uuid
  quote_id             String?       @db.Uuid
  order_number         String        @unique @db.VarChar(50)
  total_amount         Decimal       @db.Decimal(10, 2)
  status               String?       @default("pending") @db.VarChar(50)
  shipping_name        String?       @db.VarChar(200)
  shipping_address     String?
  shipping_city        String?       @db.VarChar(100)
  shipping_postal_code String?       @db.VarChar(20)
  shipping_country     String?       @db.VarChar(100)
  payment_status       String?       @default("pending") @db.VarChar(50)
  payment_method       String?       @db.VarChar(50)
  payment_id           String?       @db.VarChar(255)
  created_at           DateTime?     @default(now()) @db.Timestamp(6)
  updated_at           DateTime?     @default(now()) @db.Timestamp(6)
  completed_at         DateTime?     @db.Timestamp(6)
  order_items          order_items[]
  quotes               quotes?       @relation(fields: [quote_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users                users?        @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@index([status], map: "idx_orders_status")
  @@index([user_id], map: "idx_orders_user_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model payment_methods {
  id                       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                  String   @db.Uuid
  stripe_customer_id       String   @db.VarChar(255)
  stripe_payment_method_id String   @unique @db.VarChar(255)
  brand                    String?  @db.VarChar(50)
  last4                    String?  @db.Char(4)
  exp_month                Int?     @db.SmallInt
  exp_year                 Int?     @db.SmallInt
  is_default               Boolean  @default(false)
  created_at               DateTime @default(now()) @db.Timestamp(6)
  users                    users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_payment_methods_user_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model print_configs {
  id                Int       @id @default(autoincrement())
  name              String    @db.VarChar(100)
  layer_height      Decimal   @db.Decimal(5, 3)
  infill_percentage Int
  support_enabled   Boolean?  @default(false)
  print_speed       Int?
  time_multiplier   Decimal?  @default(1.0) @db.Decimal(5, 2)
  created_at        DateTime? @default(now()) @db.Timestamp(6)
  quotes            quotes[]
}

model products {
  id                Int           @id @default(autoincrement())
  name              String        @db.VarChar(255)
  description       String?
  category          String?       @db.VarChar(100)
  price             Decimal       @db.Decimal(10, 2)
  material_id       Int?
  weight_grams      Int?
  dimensions_x      Decimal?      @db.Decimal(10, 2)
  dimensions_y      Decimal?      @db.Decimal(10, 2)
  dimensions_z      Decimal?      @db.Decimal(10, 2)
  stock_quantity    Int?          @default(0)
  is_available      Boolean?      @default(true)
  primary_image_url String?
  images            Json?
  created_at        DateTime?     @default(now()) @db.Timestamp(6)
  updated_at        DateTime?     @default(now()) @db.Timestamp(6)
  order_items       order_items[]
  materials         materials?    @relation(fields: [material_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([category], map: "idx_products_category")
  @@index([is_available], map: "idx_products_is_available")
}

model quotes {
  id                           String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  session_id                   String?        @db.VarChar(255)
  user_id                      String?        @db.Uuid
  stl_filename                 String         @db.VarChar(255)
  s3_key                       String         @db.VarChar(500)
  volume_cm3                   Decimal        @db.Decimal(12, 4)
  surface_area_cm2             Decimal?       @db.Decimal(12, 4)
  bounding_box_x               Decimal?       @db.Decimal(10, 2)
  bounding_box_y               Decimal?       @db.Decimal(10, 2)
  bounding_box_z               Decimal?       @db.Decimal(10, 2)
  material_id                  Int?
  print_config_id              Int?
  material_cost                Decimal?       @db.Decimal(10, 2)
  machine_cost                 Decimal?       @db.Decimal(10, 2)
  labor_cost                   Decimal?       @db.Decimal(10, 2)
  total_price                  Decimal        @db.Decimal(10, 2)
  estimated_print_time_minutes Int?
  status                       String?        @default("pending") @db.VarChar(50)
  expires_at                   DateTime?      @db.Timestamp(6)
  created_at                   DateTime?      @default(now()) @db.Timestamp(6)
  updated_at                   DateTime?      @default(now()) @db.Timestamp(6)
  orders                       orders[]
  materials                    materials?     @relation(fields: [material_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  print_configs                print_configs? @relation(fields: [print_config_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users                        users?         @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@index([session_id], map: "idx_quotes_session_id")
  @@index([status], map: "idx_quotes_status")
  @@index([user_id], map: "idx_quotes_user_id")
}

model users {
  id                         String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email                      String            @unique @db.VarChar(255)
  password_hash              String            @db.VarChar(255)
  first_name                 String?           @db.VarChar(100)
  last_name                  String?           @db.VarChar(100)
  created_at                 DateTime?         @default(now()) @db.Timestamp(6)
  updated_at                 DateTime?         @default(now()) @db.Timestamp(6)
  email_verified             Boolean?          @default(false)
  verification_token         String?           @db.VarChar(255)
  verification_token_expires DateTime?         @db.Timestamp(6)
  username                   String?           @unique @db.VarChar(255)
  addresses                  addresses[]
  orders                     orders[]
  payment_methods            payment_methods[]
  quotes                     quotes[]
}
